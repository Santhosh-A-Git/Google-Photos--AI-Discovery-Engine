# Phase 1: Ingestion (Apify)
APIFY_API_TOKEN="your_apify_api_token_here"
# Default actor for Reddit scraping
APIFY_ACTOR_ID="trudax/reddit-scraper" 
# Official Google Cloud YouTube API Key
YOUTUBE_API_KEY="your_youtube_api_key_here"
# Default actor for Twitter scraping
APIFY_TWITTER_ACTOR_ID="microworlds/twitter-scraper"
# Default actor for Facebook search
APIFY_FACEBOOK_ACTOR_ID="apify/facebook-search-scraper"
# Default actor for Google Search (Forums)
APIFY_GOOGLE_SEARCH_ACTOR_ID="apify/google-search-scraper"
# Comma-separated list of YouTube video URLs to scrape
YOUTUBE_VIDEO_URLS=""

# Phase 2: Vector Storage (ChromaDB)
# (ChromaDB runs locally, no API keys required!)

# Phase 3: AI Inference (Groq)
GROQ_API_KEY="your_groq_api_key_here"

# Database Configuration (Leave empty for local SQLite, Railway will inject this automatically in production)
DATABASE_URL=""
